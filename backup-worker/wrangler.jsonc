{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bridge-night-backup",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // No public URL needed: it only runs on its timers.
  "workers_dev": false,
  "triggers": {
    "crons": ["30 4 * * *", "0 3 * * 1"]
  },
  "vars": {
    "SUPABASE_URL": "https://kimgoxjydargqtbwolxz.supabase.co"
  },
  // SUPABASE_SECRET_KEY is set with `wrangler secret put` (never in git).
  "kv_namespaces": [{ "binding": "BACKUPS", "id": "REPLACE_WITH_KV_ID" }],
  "observability": { "enabled": true }
}
